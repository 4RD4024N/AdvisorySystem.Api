{
  "ConnectionStrings": {
    "Default": "Server=tcp:advisorysystem-sqlserver.database.windows.net,1433;Database=AdvisorySystemDB;User ID=sqladmin;Password=REPLACE_WITH_YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Jwt": {
    "Issuer": "AdvisorySystem",
    "Audience": "AdvisorySystem",
    "Key": "REPLACE_WITH_AZURE_KEY_VAULT_SECRET",
    "ExpiresMinutes": 120
  },
  "Storage": {
    "Root": "wwwroot/uploads",
    "MaxFileSize": 104857600
  },
  "Azure": {
    "StorageConnectionString": "DefaultEndpointsProtocol=https;AccountName=REPLACE_WITH_STORAGE_ACCOUNT;AccountKey=REPLACE_WITH_KEY;EndpointSuffix=core.windows.net",
    "ContainerName": "documents",
    "KeyVaultUrl": "https://advisorysystem-keyvault.vault.azure.net/",
    "ApplicationInsights": {
      "ConnectionString": "InstrumentationKey=REPLACE_WITH_INSTRUMENTATION_KEY;IngestionEndpoint=https://REPLACE_WITH_REGION.in.applicationinsights.azure.com/"
    }
  },
  "Logging": {
    "LogLevel": {
"Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning"
    },
    "ApplicationInsights": {
 "LogLevel": {
   "Default": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
